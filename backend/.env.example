# Server
PORT=5000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://jobboard:jobboard@localhost:5432/jobboard

# Redis
REDIS_URL=redis://localhost:6380

# JWT
ACCESS_TOKEN_SECRET=supersecretaccesstokenkey12345678901234567890
ACCESS_TOKEN_EXPIRY=30m
REFRESH_TOKEN_SECRET=supersecretrefreshtokenkey12345678901234567890
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=cloudinaryname
CLOUDINARY_API_KEY=cloudinaryapikey
CLOUDINARY_API_SECRET=cloudinaryapisecret

# Email
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mailtrapusername
SMTP_PASS=mailtrappassword

# Client
CLIENT_URL=http://localhost:5173
